{
  "name": "raftjs-devtypes-app",
  "version": "0.1.0",
  "private": true,
  "description": "Device Types: browse Raft device type records and manage a device's device type file",
  "scripts": {
    "start": "parcel src/index.html",
    "clean": "rimraf dist .parcel-cache",
    "build": "npm run clean && parcel build src/index.html --public-url ./",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "author": "Rob Dobson",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/web-bluetooth": "^0.0.21",
    "buffer": "^6.0.3",
    "parcel": "^2.16.3",
    "process": "^0.11.10",
    "rimraf": "^6.1.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "isomorphic-ws": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
