{
    "name": "@robdobsn/raftjs",
    "version": "2.9.1",
    "description": "Javascript/TS library for Raft library",
    "main": "dist/web/main.js",
    "types": "dist/web/main.d.ts",
    "react-native": "dist/react-native/main.js",
    "author": "Rob Dobson <rob@dobson.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/robdobsn/raftjs.git"
    },
    "bugs": {
        "url": "https://github.com/robdobsn/raftjs/issues"
    },
    "license": "MIT",
    "keywords": [
        "Raft"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "build:phone": "tsc -p tsconfig.react-native.json",
        "build-all": "npm run clean && npm run build && npm run build:phone",
        "lint": "eslint ./src",
        "test": "jest",
        "clean": "rimraf dist build package",
        "docs": "typedoc --entryPoints src/main.ts",
        "watch-all": "tsc -p tsconfig.json --watch & tsc -p tsconfig.react-native.json --watch",
        "vcp:find-signal": "node tests/e2e/vcp-find-signal.mjs"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.13.11",
        "@types/text-encoding": "^0.0.40",
        "@types/web-bluetooth": "^0.0.21",
        "@types/ws": "^8.18.2",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "eslint": "^9.23.0",
        "jest": "^30.5.2",
        "react-native-ble-plx": "^3.5.0",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.6",
        "typescript": "^5.8.2",
        "ws": "^8.22.0"
    },
    "dependencies": {
        "isomorphic-ws": "^5.0.0",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "react-native": "*",
        "react-native-ble-plx": "*"
    },
    "allowScripts": {
        "unrs-resolver@1.12.2": true
    },
    "peerDependenciesMeta": {
        "react-native": {
            "optional": true
        },
        "react-native-ble-plx": {
            "optional": true
        }
    }
}
